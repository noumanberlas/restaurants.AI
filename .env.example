# ──────────────────────────────────────────────────────────────────────────────
# Model Provider: "foundry" to use Microsoft Foundry, "ollama" for local Ollama
# ──────────────────────────────────────────────────────────────────────────────
MODEL_PROVIDER=foundry

# ──────────────────────────────────────────────────────────────────────────────
# Microsoft Foundry (MODEL_PROVIDER=foundry)
# ──────────────────────────────────────────────────────────────────────────────
# The AF framework reads FOUNDRY_PROJECT_ENDPOINT and FOUNDRY_MODEL automatically
FOUNDRY_PROJECT_ENDPOINT=https://<your-project>.services.ai.azure.com/api/projects/<project-name>
FOUNDRY_MODEL=gpt-4o

# Per-agent model overrides (leave blank to use FOUNDRY_MODEL as the default)
FOUNDRY_MODEL_MENU_AGENT=gpt-4o
FOUNDRY_MODEL_ORDER_AGENT=gpt-4o
FOUNDRY_MODEL_RESERVATION_AGENT=gpt-4o
FOUNDRY_MODEL_INVENTORY_AGENT=gpt-4o
FOUNDRY_MODEL_HOST_AGENT=gpt-4o

# ──────────────────────────────────────────────────────────────────────────────
# Ollama local (MODEL_PROVIDER=ollama)
# ──────────────────────────────────────────────────────────────────────────────
# Ollama is accessed through its OpenAI-compatible /v1 API.
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Per-agent model overrides (leave blank to use OLLAMA_MODEL as the default)
OLLAMA_MODEL_MENU_AGENT=llama3.2
OLLAMA_MODEL_ORDER_AGENT=llama3.2
OLLAMA_MODEL_RESERVATION_AGENT=llama3.2
OLLAMA_MODEL_INVENTORY_AGENT=llama3.2
OLLAMA_MODEL_HOST_AGENT=llama3.2

# ──────────────────────────────────────────────────────────────────────────────
# Observability (instrumentation enabled by default)
# ──────────────────────────────────────────────────────────────────────────────
ENABLE_INSTRUMENTATION=true
ENABLE_SENSITIVE_DATA=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317/
AZURE_MONITOR_CONNECTION_STRING=

# ──────────────────────────────────────────────────────────────────────────────
# Application
# ──────────────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8088
